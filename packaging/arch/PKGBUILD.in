pkgname=cockpit-hpssa
pkgver=VERSION
pkgrel=1
pkgdesc='Cockpit plugin for managing HPE Smart Array (ssacli) storage'
arch=('x86_64')
url='https://github.com/volfco/hpssa-cockpit-plugin'
license=(LGPL)
source=("SOURCE")
sha256sums=('SKIP')

package() {
  depends=(cockpit)
  cd $pkgname
  make DESTDIR="$pkgdir" install PREFIX=/usr
}
